students = {}

while True:
    print("\n1.Add Student")
    print("2.Display")
    print("3.Search")
    print("4.Delete")
    print("5.Exit")

    ch = input("Choice: ")

    if ch == "1":
        roll = input("Roll No: ")
        name = input("Name: ")
        mark = float(input("Mark: "))
        students[roll] = [name, mark]

    elif ch == "2":
        for roll, data in students.items():
            print(roll, data[0], data[1])

    elif ch == "3":
        roll = input("Enter Roll No: ")
        if roll in students:
            print(students[roll])
        else:
            print("Not Found")

    elif ch == "4":
        roll = input("Enter Roll No: ")
        students.pop(roll, None)

    elif ch == "5":
        break
